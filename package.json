{
  "name": "kiddy-land",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "format": "oxfmt --check",
    "check-types": "turbo run check-types",
    "lint:fix": "oxlint --fix .",
    "format:fix": "oxfmt .",
    "quality": "turbo run //#quality",
    "quality:fix": "turbo run //#quality:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.~57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.2",
    "typescript": "~6"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "packageManager": "bun@1.3.14"
}
